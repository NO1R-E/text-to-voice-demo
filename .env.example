# Copy this file to .env and fill in your own values. Never commit .env.

# --- The app (Supabase → Project Settings → API) ---
# Both are public by design; Row Level Security keeps each visitor's data private.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Tests only: a local PostgreSQL (tests use "<name>_test", never this database itself) ---
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/task-voice
